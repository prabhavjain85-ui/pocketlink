{
  "name": "pocketlink",
  "version": "1.0.0",
  "description": "Drug Discovery Staging Bench — Search PDB targets, shortlist PubChem compounds, rank the best AI follow-up",
  "private": true,
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "dev": "PORT=3000 HOST=0.0.0.0 BROWSER=none react-scripts start",
    "start": "PORT=3000 HOST=0.0.0.0 BROWSER=none react-scripts start",
    "build": "BUILD_PATH=dist react-scripts build",
    "lint": "eslint src --ext .js,.jsx --max-warnings=10",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.1.0"
  }
}
