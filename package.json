{
  "name": "targetforge",
  "version": "1.0.0",
  "description": "AI-powered drug discovery for drug repurposing, target identification, molecular docking, ADME analysis, and automated research.",
  "private": true,
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "dev": "PORT=3000 HOST=0.0.0.0 BROWSER=none react-scripts start",
    "start": "PORT=3000 HOST=0.0.0.0 BROWSER=none react-scripts start",
    "build": "BUILD_PATH=dist react-scripts build && node scripts/inject-seo-html.mjs",
    "lint": "eslint src --ext .js,.jsx --max-warnings=10",
    "test": "react-scripts test",
    "benchmark": "node benchmark/runBenchmark.mjs",
    "benchmark:heldout": "node benchmark/evaluateHeldoutSplits.mjs",
    "benchmark:chembl-audit": "python3 benchmark/chemblFetchAudit.py",
    "benchmark:fast": "node benchmark/runBenchmark.mjs --skip-docking",
    "benchmark:redock": "CI=true RUN_REDOCK_BENCH=1 react-scripts test --watchAll=false --runInBand --testPathPattern=benchmark/redockValidation",
    "benchmark:build-heldout": "python3 benchmark/buildHeldoutBenchmark.py && node scripts/buildTargetReferenceBundle.mjs",
    "build:trial-rates": "node scripts/build-trial-success-rates.mjs",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.1.0"
  }
}
