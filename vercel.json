{
  "outputDirectory": "dist",
  "functions": {
    "api/rank-candidates.js": {
      "maxDuration": 30
    },
    "api/pains-check.js": {
      "maxDuration": 15
    },
    "api/contact.js": {
      "maxDuration": 10
    },
    "api/quantum-insight.py": {
      "maxDuration": 120,
      "excludeFiles": "{src/**,public/**,dist/**,scripts/**,node_modules/**,**/*.test.js,**/*.test.jsx,**/*.test.py}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
